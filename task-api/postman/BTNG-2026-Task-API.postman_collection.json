                  "pm.test('selalu ada message', function () { pm.expect(pm.response.json()).to.have.property('message'); });",
                  "pm.test('message: Detail task berhasil diambil', function () { pm.expect(pm.response.json().message).to.eql('Detail task berhasil diambil'); });",
                  "pm.test('data.id = 1', function () { pm.expect(pm.response.json().data.id).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
