        {
          "name": "4. PATCH /tasks/:id (update) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('selalu ada message', function () { pm.expect(pm.response.json()).to.have.property('message'); });",
                  "pm.test('message: Task berhasil diperbarui', function () { pm.expect(pm.response.json().message).to.eql('Task berhasil diperbarui'); });",
                  "pm.test('is_completed boolean true', function () { pm.expect(pm.response.json().data.is_completed).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"is_completed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
