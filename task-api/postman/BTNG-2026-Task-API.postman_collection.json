          "name": "7. POST /tasks title kosong -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422 Unprocessable Content', function () { pm.response.to.have.status(422); });",
                  "pm.test('selalu ada message', function () { pm.expect(pm.response.json()).to.have.property('message'); });",
                  "pm.test('ada errors per field', function () { pm.expect(pm.response.json()).to.have.nested.property('errors.title'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
